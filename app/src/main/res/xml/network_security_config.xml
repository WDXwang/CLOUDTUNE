<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许局域网内自建 AList 使用明文 HTTP（例如 http://192.168.x.x:5244） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
